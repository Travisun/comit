# ---- App ----
APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost
AUTH_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# ---- Session lifetime ----
# 会话绝对寿命（天）：自签发起无论活跃度强制过期重登（滑动续期不越过此限）。默认 180
# SESSION_ABSOLUTE_DAYS=180

# ---- Seed (pnpm db:seed) ----
# db:seed 管理员口令（须 ≥8 位含字母数字）；未提供时：交互式开发随机生成一次性口令
# 并打印，非交互环境拒绝执行；NODE_ENV=production 一律拒绝。演示用户需显式 `--demo`
# SEED_ADMIN_PASSWORD=

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://blog:CHANGE_ME@localhost:5433/myblogs

# ---- SMTP (mail delivery) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MyBlogs <no-reply@localhost>"

# ---- OAuth providers (auto-register on first login) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Discourse as SSO Provider (we are the SSO client)
DISCOURSE_SSO_URL=https://forum.example.com/session/sso_provider
DISCOURSE_SSO_SECRET=
# Cloudflare Access (Zero Trust) JWT login
CF_ACCESS_TEAM=
# AUD token：必填。留空将禁用 CF Access 登录（防止同 Team 其它应用的 JWT 复用登录）
CF_ACCESS_AUD=

# ---- Redis (optional, rate-limit first-tier driver; degrades to PG/memory) ----
# REDIS_URL=redis://127.0.0.1:6379

# ---- Reverse proxy trust (rate-limit IP source) ----
# direct  = app exposed directly; NEVER trust proxy headers (use this unless behind a proxy)
# nginx   = behind nginx on the same host; trusts X-Real-IP
# cloudflare = behind Cloudflare; trusts rightmost XFF entry
# WARNING: "nginx"/"cloudflare" with the port directly exposed lets attackers
# spoof IPs and bypass all per-IP rate limits.
TRUST_PROXY=nginx

# ---- Logging ----
# LOG_LEVEL=info

# ---- LLM (moderation etc.) ----
# Set to 1 only if you point provider baseUrl at a LOCAL inference server
# (Ollama etc.); default blocks private/link-local URLs to prevent SSRF.
# LLM_ALLOW_INTERNAL_BASEURL=0

# ---- Queue (pg-boss uses DATABASE_URL) ----
QUEUE_CONCURRENCY=3

# ---- Concurrency / cluster (see docs/concurrency.md) ----
# worker processes for `pnpm start:cluster`; PG pool per worker
WEB_CONCURRENCY=2
PGPOOL_MAX=10
UV_THREADPOOL_SIZE=8
# keep workers × PGPOOL_MAX well under Postgres max_connections

# ---- Storage (media attachments; docs/operations.md §1 Storage 小节) ----
# 新上传写入驱动：local（默认，落 ./storage/media）| r2（Cloudflare R2 S3 API）
# 只影响新写入；存量行按 media.storage 按行分派读/删（混存兼容，可随时切换）
STORAGE_DRIVER=local
# R2 四件套（STORAGE_DRIVER=r2 时必填；缺失会 fail-safe 回落 local 并打 [storage] error）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 桶名。桶必须专用（只放本应用媒体对象）；私有桶形态下应用路由按键形状守卫防非媒体对象外泄
R2_BUCKET=
# 可选：配置后为「公开桶」形态，新上传图片 URL 直连 R2/CDN（自定义域或 r2.dev，无尾斜杠）
R2_PUBLIC_BASE_URL=

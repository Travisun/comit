# ==== docker-compose.server.yml 环境变量（复制为 .env 后填写） ====

# 应用对外地址（宝塔 nginx 反代后的 https 域名）。影响绝对链接/RSS/OG/HSTS 下发
APP_URL=https://your-domain.com
# 用户子域功能的根域（不用子域功能可留 localhost）
ROOT_DOMAIN=your-domain.com

# 宿主机已有 PostgreSQL 实例（host 网络模式直连 127.0.0.1）。
# 建议专库专用：CREATE DATABASE myblogs + 独立账号，只授予该库权限。
DATABASE_URL=postgresql://myblogs:CHANGE_ME@127.0.0.1:5432/myblogs

# 宿主机已有 Redis（限流一级驱动；带密码时写 redis://:PASSWORD@127.0.0.1:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0

# 会话/签名用密钥，生产必填（32+ 字符随机值）：
#   openssl rand -base64 48
AUTH_SECRET=

# 反代形态声明：宝塔 nginx ⇒ 保持 nginx（X-Real-IP / X-Forwarded-For 解析）
TRUST_PROXY=nginx

# ==== 以下可选 ====
# SMTP（后台也可配，env 为回落值）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="MyBlogs <no-reply@your-domain.com>"
# 存储：默认本地盘（命名卷持久化）；切 R2 时取消注释
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# 队列 worker 并发（默认 3）
# QUEUE_CONCURRENCY=3
